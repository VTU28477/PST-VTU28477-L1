class Solution {
public:
    bool halvesAreAlike(string s) {
        int n = s.length();
        int count = 0;

        for (int i = 0; i < n / 2; i++) {
            if (isVowel(s[i])) {
                count++;
            }
        }

        for (int i = n / 2; i < n; i++) {
            if (isVowel(s[i])) {
                count--;
            }
        }

        return count == 0;
    }

private:
    bool isVowel(char c) {
        return c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u' ||
               c == 'A' || c == 'E' || c == 'I' || c == 'O' || c == 'U';
    }
};
