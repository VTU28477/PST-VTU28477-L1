class Solution {
    public int[][] transpose(int[][] matrix) {
        int m = matrix.length; // rows
        int n = matrix[0].length; // columns

        // transpose will have dimensions n x m
        int[][] result = new int[n][m];

        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                result[j][i] = matrix[i][j]; // flip row and column
            }
        }

        return result;
    }
}
